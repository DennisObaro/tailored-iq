# Local dev-environment cache override — unrelated to this project, safe to
# remove on your own machine. (Left over from initial project setup.)
cache=/private/tmp/claude-501/-Users-dennis-Desktop-Tailored-IQ/df0881b2-ffa7-4e62-b4f9-34fccb7c5001/scratchpad/npm-cache

# Hugeicons Pro private registry. The token is pulled from the
# HUGEICONS_LICENSE_KEY environment variable at install time — it is never
# written into this file, so this file is safe to commit.
# Set the env var in your shell before installing, e.g.:
#   export HUGEICONS_LICENSE_KEY=your-universal-license-key
# (npm reads real OS environment variables here — it does NOT read .env
# files — see .env.example for where this key is documented.)
@hugeicons-pro:registry=https://npm.hugeicons.com/
//npm.hugeicons.com/:_authToken=${HUGEICONS_LICENSE_KEY}
